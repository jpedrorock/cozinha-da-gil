# Reduz contexto enviado ao Docker daemon — build mais rápido + image menor.
# Tudo aqui NÃO vai pro container.

# Dev artifacts
node_modules
.next
.next/cache
out
build
dist
coverage
test-results
playwright-report
*.tsbuildinfo

# Git
.git
.gitignore
.gitattributes

# Editor / OS
.vscode
.idea
.DS_Store
*.swp
*.swo

# Secrets — nunca pro container build
.env
.env.local
.env.*.local
.env.development
.env.production

# DB local — em prod, o volume cria o seu próprio
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-wal
prisma/dev.db-shm
prisma/backups

# Docs / não-runtime
docs
e2e
tests
README.md
*.md

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude / local tooling
.claude

# Playwright / Vitest configs (não precisam em prod)
playwright.config.ts
vitest.config.ts

# PM2 ecosystem (alternativa de deploy, não-Docker)
ecosystem.config.js
