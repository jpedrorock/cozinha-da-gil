# Cozinha da Gil — env template.
# Copia esse arquivo pra `.env` e troca os valores. `.env` está no .gitignore.

# Banco SQLite local (default funciona em qualquer máquina).
# Em produção, considera SQLite + WAL mesmo, ou migra pra Postgres no Coolify.
DATABASE_URL="file:./dev.db"

# Chave de cifra da sessão (iron-session). 32 bytes random em base64.
# Gera com: `openssl rand -base64 32`
# Trocar invalida todas as sessões ativas — usuários precisam logar de novo.
SESSION_SECRET="REPLACE_WITH_BASE64_32_BYTES_RANDOM"

# Backup diário automático do SQLite. Em produção (Coolify), deixa true.
# Em dev local, false pra não criar lixo em ./data/backups.
BACKUP_SCHEDULE_ENABLED="false"
# Hora do dia (0-23) pra rodar o backup. Default 03:00.
BACKUP_HOUR="3"
# Quantos dias de backup manter. Default 14.
BACKUP_KEEP_DAYS="14"
# Onde mora o SQLite + backups. Em prod (Docker): /app/data/*
DB_PATH="./prisma/dev.db"
BACKUPS_DIR="./data/backups"
